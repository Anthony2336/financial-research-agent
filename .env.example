# P0 / P1 / P2 shared local persistence
DATABASE_URL=postgresql+psycopg://financial_evidence:financial_evidence@localhost:5432/financial_evidence
REFUSAL_PERSISTENCE_CONNECT_TIMEOUT_SECONDS=1
OFFLINE_DEMO=false
REDIS_URL=redis://localhost:6379/0

# SEC ingest and local retrieval
SEC_USER_AGENT=Example Research Operator research-operator@example.com
SEC_CACHE_TTL_SECONDS=86400
XBRL_MAX_RESPONSE_BYTES=26214400
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_CACHE_DIR=.model-cache/bge-m3
RERANKER_MODEL=ms-marco-MiniLM-L-12-v2
RERANKER_CACHE_DIR=.model-cache/flashrank
CONTEXT_COMPRESSOR_MODEL=microsoft/llmlingua-2-xlm-roberta-large-meetingbank
CONTEXT_COMPRESSOR_CACHE_DIR=.model-cache/llmlingua
TOKENIZER_CACHE_DIR=.model-cache/tokenizer
RESEARCH_MEMORY_TTL_DAYS=90

# OpenAI capability profile for production thesis/auto/company/earnings/industry/quality
FAST_MODEL=
ANALYST_MODEL=
OPENAI_API_KEY=

# Allowlisted web fallback and industry/market-context authority domains
TAVILY_API_KEY=
WEB_SEARCH_TIMEOUT_SECONDS=10
WEB_ISSUER_DOMAINS={}
WEB_INDUSTRY_AUTHORITY_DOMAINS=["ftc.gov","justice.gov","commerce.gov","federalregister.gov"]

# Langfuse Cloud trace, dataset sync, and application experiment
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Alpaca Basic IEX-only market data
MARKET_DATA_PROVIDER=alpaca
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_DATA_FEED=iex
ALPACA_TRADING_ENVIRONMENT=paper
MARKET_DATA_TIMEOUT_SECONDS=5
MARKET_DATA_MAX_BARS=5
MARKET_DATA_MAX_STALENESS_SECONDS=90
MARKET_CONTEXT_WINDOW_DAYS=3
MARKET_ABNORMAL_MOVE_THRESHOLD=0.05
RESEARCH_QUALITY_MAX_SOURCE_AGE_DAYS=365
